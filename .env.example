# ==============================================================================
# Tidbyt Device Configuration
# ==============================================================================
# Grab these from the Tidbyt mobile app:
# Settings -> Developer -> Get API Key (or Settings -> General -> Device ID)
TIDBYT_API_TOKEN="your_tidbyt_api_token_here"
TIDBYT_DEVICE_ID="your_tidbyt_device_id_here"

# ==============================================================================
# App Configurations
# ==============================================================================

# Stocks: Default ticker symbol to track (e.g., AAPL, NVDA, SPY, TSLA)
STOCK_TICKER="AAPL"

# GitHub: Comma-separated list of repos to rotate through (e.g. owner/repo,owner/repo)
GITHUB_REPOS="wesbillman/vibes_ui,tidbyt/pixlet"

# Optional: GitHub Personal Access Token (PAT)
# Only required if you want to track private repos or need higher API rate limits
GITHUB_TOKEN=""
